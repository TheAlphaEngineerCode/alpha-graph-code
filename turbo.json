{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",

  "globalDependencies": ["tsconfig.base.json", "pnpm-lock.yaml"],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig*.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig*.json", "package.json"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
